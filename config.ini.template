# Folders to sync, one per "|" line: a Drive folder link (shared "Anyone with the link" as Editor)
# or a local folder
folders=

# Bot account login. If the token file doesn't exist, a browser opens to log in as the bot once
client_secret_path=./secrets/client_secret.json
token_path=./secrets/token.json

# Seconds between checks
interval=10

# Seconds a file must be unchanged before it's merged (uploads can still be in progress)
settle=5
